# ==========================================
# Core Platform Settings
# ==========================================
PROJECT_NAME="AI Task Management Platform"
DEBUG=True



# ==========================================
# Celery & Redis Configuration
# ==========================================
REDIS_HOST="localhost"
REDIS_PORT="6379"

# ==========================================
# Telegram Bot Configuration
# ==========================================
# Get this from BotFather on Telegram
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
# Optional: Only needed if running in Webhook mode instead of Polling
TELEGRAM_WEBHOOK_URL=""

# Mapping of developer names (lowercase) to their Telegram Chat IDs
# This allows them to receive direct notifications when assigned a task.
# Example: '{"ali": 111111111, "mobin": 222222222}'
DEV_TELEGRAM_IDS='{}'

# ==========================================
# AI & Model Configuration
# ==========================================
# Groq API Key for Extraction & Translation
GROQ_API_KEY="your_groq_api_key_here"
# Threshold for AI confidence (0.0 to 1.0). If lower, bot asks for clarification.
CONFIDENCE_THRESHOLD=0.85

# ==========================================
# Task Provider Configuration
# ==========================================
# Active provider can be: "mock", "plane", or "linear"
ACTIVE_PROVIDER="plane"

# --- Plane.so Settings ---
PLANE_API_KEY="your_plane_api_key_here"
PLANE_WORKSPACE_SLUG="your_workspace_slug"
PLANE_PROJECT_ID="your_project_id"

# --- Linear Settings (Future Support) ---
LINEAR_API_KEY="your_linear_api_key_here"
LINEAR_TEAM_ID="your_linear_team_id"
